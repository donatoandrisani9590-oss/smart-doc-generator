# ═══════════════════════════════════════════════════════════════════════════
# STAGING Environment Variables
# Copy to .env.staging and fill in the values
# ═══════════════════════════════════════════════════════════════════════════

# ─── Environment ──────────────────────────────────────────────────────────
ENVIRONMENT=staging
DEBUG=false
SHOW_API_DOCS=true

# ─── Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))") ─
SECRET_KEY=
REFRESH_SECRET_KEY=

# ─── Database (Railway Staging) ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/docgen_staging

# ─── Redis (Railway Staging) ─────────────────────────────────────────────
REDIS_URL=redis://default:password@host:6379/0
CELERY_BROKER_URL=redis://default:password@host:6379/0
CELERY_RESULT_BACKEND=redis://default:password@host:6379/0

# ─── URLs ─────────────────────────────────────────────────────────────────
API_BASE_URL=https://staging-api.up.railway.app
CORS_ORIGINS=https://staging-frontend.vercel.app

# ─── Frontend (Vercel Staging) ────────────────────────────────────────────
VITE_API_URL=https://staging-api.up.railway.app
VITE_APP_VERSION=staging

# ─── E-Mail (optional for staging) ───────────────────────────────────────
# MAIL_SERVER=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=noreply-staging@niederwieser.com
# MAIL_FROM_NAME=DocGen Staging
# MAIL_USE_TLS=true

# ─── Monitoring (optional) ───────────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.5
