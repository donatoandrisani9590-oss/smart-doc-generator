# ══════════════════════════════════════════════════════════════════════════════
# Document Generator - Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
#
# DEVELOPMENT SETUP:
#   1. Copy this file to .env: cp .env.example .env
#   2. Fill in all required values (marked with REQUIRED)
#   3. Run: docker-compose up -d
#
# PRODUCTION SETUP:
#   1. Copy this file to .env.prod: cp .env.example .env.prod
#   2. Generate strong secrets for all keys
#   3. Run: docker-compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# WICHTIG: Diese Datei NIEMALS mit echten Secrets committen!
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL credentials
POSTGRES_USER=docgen
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_DB=docgen_db

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────

# JWT Secret Key - MUSS gesetzt werden (min. 32 Zeichen)
# Generiere mit: openssl rand -base64 64
SECRET_KEY=CHANGE_ME_TO_SECURE_SECRET_KEY_AT_LEAST_32_CHARS

# ─────────────────────────────────────────────────────────────────────────────
# CORS CONFIGURATION (REQUIRED for Production)
# ─────────────────────────────────────────────────────────────────────────────

# Komma-getrennte Liste erlaubter Origins
# Development: http://localhost:5173,http://localhost:3000
# Production: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL SETTINGS
# ─────────────────────────────────────────────────────────────────────────────

# Debug mode (nur für Development!)
DEBUG=true

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# CLOUD SYNC (Optional)
# ─────────────────────────────────────────────────────────────────────────────

# SharePoint Integration
# SHAREPOINT_TENANT=
# SHAREPOINT_SITE=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL NOTIFICATIONS (Optional)
# ─────────────────────────────────────────────────────────────────────────────

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
